# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# See architecture doc section 9. Local builds need the DB_* + ANTHROPIC_API_KEY
# block; deployed builds need ANTHROPIC_API_KEY + REDIS_URL + CORS_ALLOWED_ORIGIN.

DEPLOY_MODE=local                       # local | deployed

# --- local / ingestion ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=benchmark
DB_ETL_USER=
DB_ETL_PASSWORD=
DB_AGENT_USER=
DB_AGENT_PASSWORD=
SQLITE_PATH=./analytics.db             # deployed instance reads this instead of DB_*
SOCRATA_APP_TOKEN=
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5            # deployed instance sets claude-haiku-4-5
MAX_SQL_ROWS=1000
MAX_AGENT_ITERS=8
SQL_TIMEOUT_MS=5000

# --- public deployment only (section 10) ---
DEMO_ENABLED=true                      # false -> /ask returns the offline-fallback payload
RATE_LIMIT_PER_VISITOR_PER_DAY=5       # cached answers don't count
GLOBAL_DAILY_QUESTION_CAP=300          # backstop against distributed abuse
MONTHLY_BUDGET_USD=15                  # running cost counter trips DEMO_ENABLED=false
RESPONSE_CACHE_TTL_DAYS=30
REDIS_URL=                             # Upstash — rate-limit counters + response cache
TURNSTILE_SECRET=                      # blank = disabled
CORS_ALLOWED_ORIGIN=                   # e.g. https://your-portfolio-domain
ALERT_EMAIL=                           # uptime + budget alerts
