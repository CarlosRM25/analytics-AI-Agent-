# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# See architecture doc section 9.
#
#   local     needs nothing. SQLITE_PATH has a default; SOCRATA_APP_TOKEN is
#             optional (lifts the anonymous ingest rate limit); ANTHROPIC_API_KEY
#             is needed once you run the agent.
#   deployed  requires ANTHROPIC_API_KEY + REDIS_URL + CORS_ALLOWED_ORIGIN.
#
# Keep comments on their own lines. A trailing "# ..." after a value can end up
# *inside* the value depending on the parser — put nothing after the "=" but the
# value itself. Leave a key blank to use its default / treat it as unset.

# local | deployed
DEPLOY_MODE=local

# --- storage + ingestion ---
# one SQLite file; ingest opens it read-write, the agent read-only
SQLITE_PATH=./analytics.db
# optional Socrata app token — register free at data.seattle.gov
SOCRATA_APP_TOKEN=

# --- agent ---
ANTHROPIC_API_KEY=
# claude-opus-5 for local use; the deployed instance sets claude-haiku-4-5
ANALYST_MODEL=claude-opus-5
MAX_SQL_ROWS=1000
MAX_AGENT_ITERS=8
SQL_TIMEOUT_MS=5000

# --- public deployment only (architecture doc section 10) ---
# false -> POST /ask returns {"disabled": true} (kill switch); no redeploy
DEMO_ENABLED=true
# novel questions per hashed IP per day; cache hits do not count
RATE_LIMIT_PER_VISITOR_PER_DAY=5
# backstop against distributed abuse
GLOBAL_DAILY_QUESTION_CAP=300
# when the month's summed usage.cost_usd reaches this, /ask behaves as disabled
MONTHLY_BUDGET_USD=15
RESPONSE_CACHE_TTL_DAYS=30
# Upstash: rate-limit counters + response cache + budget counter.
# Must start redis:// or rediss:// — anything else is ignored (feature off).
REDIS_URL=
# salts the hashed visitor IP; any stable string
RATE_LIMIT_SALT=analytics-agent
# Cloudflare Turnstile secret; blank = the /ask challenge is disabled
TURNSTILE_SECRET=
# the exact origin the browser page is served from, e.g. https://carlos.example.com
CORS_ALLOWED_ORIGIN=
# for the uptime / budget alert emails (set up outside the app)
ALERT_EMAIL=
